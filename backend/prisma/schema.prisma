// Schema do banco de dados para o sistema NexEdu
// Este arquivo define a estrutura do banco de dados usando Prisma ORM
// Saiba mais em: https://pris.ly/d/prisma-schema

// Para acelerar suas queries ou escalar facilmente com funções serverless/edge:
// Experimente o Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Modelo que representa um usuário do sistema NexEdu
/// Pode ser um professor, aluno ou pai com diferentes permissões
model User {
  /// Identificador único do usuário (chave primária)
  id Int @id @default(autoincrement())

  /// Nome completo do usuário
  name String

  /// Login único do usuário
  login String @unique

  /// Senha criptografada do usuário (hash bcrypt)
  password String

  /// Email do usuário (opcional)
  email String?

  /// Telefone do usuário (opcional)
  telefone String?

  /// Papel do usuário no sistema
  role Role

  /// Data de criação do registro
  createdAt DateTime @default(now())

  /// Data da última atualização
  updatedAt DateTime @updatedAt

  /// Posts criados pelo usuário (se for professor)
  posts Post[]

  /// Turmas em que o usuário é aluno
  turmasAluno AlunoTurma[]

  /// Turmas em que o usuário é professor
  turmasProfessor ProfessorTurma[]

  /// Registros de presença do aluno
  presencas Attendance[] @relation("AlunoPresenca")

  /// Registros de presença registrados pelo professor
  presencasRegistradas Attendance[] @relation("RegistradoPor")

  /// Mensagens enviadas pelo usuário
  mensagensEnviadas Message[] @relation("RemetenteMensagem")

  /// Mensagens sobre este aluno
  mensagensAluno Message[] @relation("AlunoMensagem")

  /// Mensagens recebidas pelo usuário (inbox)
  mensagensRecebidas MessageRecipient[]

  /// Filhos vinculados (quando é PAI)
  filhos ParentStudent[] @relation("PaiRelation")

  /// Pais vinculados (quando é ALUNO)
  pais ParentStudent[] @relation("AlunoRelation")
}

/// Enum que define os papéis possíveis de usuário
enum Role {
  PROFESSOR
  ALUNO
  PAI
  ADMIN
}

/// Enum que define os turnos possíveis
enum Turno {
  MANHA
  TARDE
  NOITE
}

/// Enum que define os tipos de mensagem
enum TipoMensagem {
  INDIVIDUAL
  TURMA
  GERAL
}

/// Modelo que representa uma turma
model Turma {
  id        Int      @id @default(autoincrement())
  nome      String
  serie     String
  turno     Turno
  anoLetivo Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  alunos      AlunoTurma[]
  professores ProfessorTurma[]
  presencas   Attendance[]
  mensagens   Message[]
}

/// Tabela de junção entre Aluno e Turma
model AlunoTurma {
  alunoId   Int
  turmaId   Int
  ativo     Boolean   @default(true)
  dataFim   DateTime?
  createdAt DateTime  @default(now())

  aluno User  @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  turma Turma @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  @@id([alunoId, turmaId])
  @@map("aluno_turma")
}

/// Tabela de junção entre Professor e Turma
model ProfessorTurma {
  professorId Int
  turmaId     Int
  disciplina  String?
  createdAt   DateTime @default(now())

  professor User  @relation(fields: [professorId], references: [id], onDelete: Cascade)
  turma     Turma @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  @@id([professorId, turmaId])
  @@map("professor_turma")
}

/// Modelo para registro de presença/frequência
model Attendance {
  id            Int      @id @default(autoincrement())
  alunoId       Int
  turmaId       Int
  data          DateTime
  presente      Boolean
  justificativa String?
  registradoPor Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  aluno      User  @relation("AlunoPresenca", fields: [alunoId], references: [id], onDelete: Cascade)
  turma      Turma @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  registrado User  @relation("RegistradoPor", fields: [registradoPor], references: [id], onDelete: Cascade)

  @@unique([alunoId, turmaId, data])
}

/// Modelo para mensagens do sistema
model Message {
  id          Int          @id @default(autoincrement())
  titulo      String
  conteudo    String
  tipo        TipoMensagem
  categoria   String
  remetenteId Int
  alunoId     Int?
  turmaId     Int?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  remetente  User               @relation("RemetenteMensagem", fields: [remetenteId], references: [id], onDelete: Cascade)
  aluno      User?              @relation("AlunoMensagem", fields: [alunoId], references: [id], onDelete: SetNull)
  turma      Turma?             @relation(fields: [turmaId], references: [id], onDelete: SetNull)
  recipients MessageRecipient[]
}

/// Tabela de destinatários de mensagens
model MessageRecipient {
  id          Int       @id @default(autoincrement())
  messageId   Int
  recipientId Int
  lida        Boolean   @default(false)
  lidaEm      DateTime?
  createdAt   DateTime  @default(now())

  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  recipient User    @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@map("message_recipient")
}

/// Tabela de vínculo entre Pai e Aluno
model ParentStudent {
  parentId   Int
  studentId  Int
  parentesco String
  principal  Boolean  @default(false)
  createdAt  DateTime @default(now())

  parent  User @relation("PaiRelation", fields: [parentId], references: [id], onDelete: Cascade)
  student User @relation("AlunoRelation", fields: [studentId], references: [id], onDelete: Cascade)

  @@id([parentId, studentId])
  @@map("parent_student")
}

/// Modelo que representa um post educacional no sistema NexEdu
/// Contém informações sobre título, conteúdo e autor das postagens
model Post {
  /// Identificador único do post (chave primária)
  /// Gerado automaticamente de forma incremental
  id Int @id @default(autoincrement())

  /// Título do post educacional
  /// Campo obrigatório que representa o assunto principal
  Title String

  /// Conteúdo completo do post
  /// Campo obrigatório que contém o material educacional
  Content String

  /// Nome do autor que criou o post
  /// Campo obrigatório para identificar o criador do conteúdo
  Author String

  /// ID do usuário autor (chave estrangeira)
  /// Relaciona o post ao usuário que o criou
  authorId Int?

  /// Relacionamento com o usuário autor
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  /// Data de criação do post
  createdAt DateTime @default(now())

  /// Data da última atualização
  updatedAt DateTime @default(now()) @updatedAt
}