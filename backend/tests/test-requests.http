# Deve retornar erro 401 (Unauthorized)
GET {{baseUrl}}/posts

###

###
# Fim dos testes - NexEdu API
#
# RESUMO DOS ENDPOINTS:
#
# PÚBLICOS (não requer autenticação):
# - POST /auth/register - Registrar novo usuário
# - POST /auth/login - Fazer login
#
# LEITURA (requer autenticação - professores e alunos):
# - GET /posts - Listar todos os posts
# - GET /posts/:id - Buscar post por ID
# - GET /posts/search?q= - Buscar posts por termo
#
# APENAS PROFESSORES (requer autenticação + role PROFESSOR):
# - GET /users - Listar todos os usuários
# - GET /users/:id - Buscar usuário por ID
# - PUT /users/:id - Atualizar usuário
# - DELETE /users/:id - Deletar usuário
# - POST /posts - Criar novo post
# - PUT /posts/:id - Atualizar post
# - DELETE /posts/:id - Deletar post
#
# DICAS:
# - Sempre guarde os tokens JWT após o login
# - Tokens são válidos por 24 horas
# - Use SEU_TOKEN_PROFESSOR e SEU_TOKEN_ALUNO como placeholders
# - Teste primeiro com professor, depois com aluno para validar permissões
# - Verifique os códigos de status HTTP (200, 201, 400, 401, 403, 404, 500)
###

# ============================================================================
# NOVOS ENDPOINTS - TURMAS (PROFESSOR/ADMIN)
# ============================================================================

### CRIAR TURMA (Professor)
POST {{baseUrl}}/turmas
Authorization: Bearer {{tokenProfessor}}
Content-Type: application/json

{
  "nome": "5A",
  "serie": "5º Ano",
  "turno": "MANHA",
  "anoLetivo": 2026
}

###

### LISTAR TURMAS (Professor)
GET {{baseUrl}}/turmas
Authorization: Bearer {{tokenProfessor}}

###

### BUSCAR TURMA POR ID (Professor)
GET {{baseUrl}}/turmas/1
Authorization: Bearer {{tokenProfessor}}

###

### ATUALIZAR TURMA (Professor)
PUT {{baseUrl}}/turmas/1
Authorization: Bearer {{tokenProfessor}}
Content-Type: application/json

{
  "nome": "5A - Atualizada",
  "turno": "TARDE"
}

###

### VINCULAR ALUNOS À TURMA (Professor)
# Substitua os IDs pelos IDs reais dos alunos
POST {{baseUrl}}/turmas/1/alunos
Authorization: Bearer {{tokenProfessor}}
Content-Type: application/json

{
  "alunoIds": [2, 5]
}

###

### LISTAR ALUNOS DA TURMA (Professor)
GET {{baseUrl}}/turmas/1/alunos
Authorization: Bearer {{tokenProfessor}}

###

# ============================================================================
# NOVOS ENDPOINTS - PRESENÇA (PROFESSOR)
# ============================================================================

### REGISTRAR PRESENÇAS EM LOTE (Professor)
POST {{baseUrl}}/attendance/bulk
Authorization: Bearer {{tokenProfessor}}
Content-Type: application/json

{
  "turmaId": 1,
  "data": "2026-01-26",
  "presencas": [
    { "alunoId": 2, "presente": true },
    { "alunoId": 5, "presente": false, "justificativa": "Atestado médico" }
  ]
}

###

### BUSCAR PRESENÇAS DA TURMA POR DATA (Professor)
GET {{baseUrl}}/attendance/turma/1/date/2026-01-26
Authorization: Bearer {{tokenProfessor}}

###

### BUSCAR HISTÓRICO DE PRESENÇA DO ALUNO (Professor)
GET {{baseUrl}}/attendance/student/2
Authorization: Bearer {{tokenProfessor}}

###

### BUSCAR RESUMO DE PRESENÇA DO ALUNO (Professor)
GET {{baseUrl}}/attendance/student/2/summary
Authorization: Bearer {{tokenProfessor}}

###

# ============================================================================
# NOVOS ENDPOINTS - VÍNCULO PAI-ALUNO (ADMIN/PROFESSOR)
# ============================================================================

### VINCULAR PAI A ALUNO (Admin/Professor)
POST {{baseUrl}}/parent/link
Authorization: Bearer {{tokenProfessor}}
Content-Type: application/json

{
  "parentId": 6,
  "studentId": 2,
  "parentesco": "PAI",
  "principal": true
}

###

# ============================================================================
# NOVOS ENDPOINTS - MENSAGENS (PROFESSOR/ADMIN)
# ============================================================================

### ENVIAR MENSAGEM INDIVIDUAL (Professor)
# Mensagem para pais de um aluno específico
POST {{baseUrl}}/messages
Authorization: Bearer {{tokenProfessor}}
Content-Type: application/json

{
  "titulo": "Sobre o desempenho de Maria",
  "conteudo": "Gostaria de informar que Maria apresentou excelente desempenho na última avaliação.",
  "categoria": "DESEMPENHO",
  "alunoId": 2
}

###

### ENVIAR MENSAGEM PARA TURMA (Professor)
# Broadcast para todos os pais da turma
POST {{baseUrl}}/messages/broadcast
Authorization: Bearer {{tokenProfessor}}
Content-Type: application/json

{
  "titulo": "Reunião de Pais",
  "conteudo": "Convidamos todos os pais para a reunião que será realizada no dia 30/01/2026 às 19h.",
  "categoria": "REUNIAO",
  "turmaId": 1
}

###

### ENVIAR MENSAGEM GLOBAL (Admin/Direção)
# Mensagem para TODOS os pais do sistema
POST {{baseUrl}}/messages/global
Authorization: Bearer {{tokenAdmin}}
Content-Type: application/json

{
  "titulo": "Calendário de Feriados 2026",
  "conteudo": "Informamos os feriados previstos para o ano letivo de 2026...",
  "categoria": "COMUNICADO"
}

###

### LISTAR MENSAGENS ENVIADAS (Professor/Admin)
GET {{baseUrl}}/messages/sent
Authorization: Bearer {{tokenProfessor}}

###

# ============================================================================
# NOVOS ENDPOINTS - PAI (APENAS PAI)
# ============================================================================

### LOGIN PAI
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "login": "carlos.pai",
  "password": "senha123"
}

###

### LISTAR FILHOS (Pai)
GET {{baseUrl}}/parent/children
Authorization: Bearer {{tokenPai}}

###

### BUSCAR FREQUÊNCIA DO FILHO (Pai)
# Substitua o ID pelo ID real do filho
GET {{baseUrl}}/parent/children/2/attendance
Authorization: Bearer {{tokenPai}}

###

### DASHBOARD DO PAI
GET {{baseUrl}}/parent/dashboard
Authorization: Bearer {{tokenPai}}

###

### LISTAR INBOX - CAIXA DE ENTRADA (Pai)
GET {{baseUrl}}/messages/inbox
Authorization: Bearer {{tokenPai}}

###

### CONTAR MENSAGENS NÃO LIDAS (Pai)
GET {{baseUrl}}/messages/unread-count
Authorization: Bearer {{tokenPai}}

###

### MARCAR MENSAGEM COMO LIDA (Pai)
# Substitua o ID pelo ID real da mensagem
PUT {{baseUrl}}/messages/1/read
Authorization: Bearer {{tokenPai}}

